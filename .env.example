# ── Backend ──────────────────────────────────────────────────────────────────
BACKEND_API_URL=http://localhost:8080/api/v1
OAMP_BUFFER_DB=local_buffer.db

# ── Solo / Offline mode ────────────────────────────────────────────────────
SOLO_MODE=false
# BACKEND_API_URL=offline   # uncomment to disable all server calls

# ── Camera ──────────────────────────────────────────────────────────────────
CAMERA_INDEX=0
HIDE_CAMERA=false
DISPLAY_HALF=true

# ── Game tuning ─────────────────────────────────────────────────────────────
MAX_LEVEL=8
YOLO_SKIP_FRAMES=2
MEDIAPIPE_SKIP_FRAMES=2
MODEL_BANTAL=false

# ── 1v1 Match (Go backend WS) ──────────────────────────────────────────────
MATCH_ROOM_ID=

# ── LAN Master Push ─────────────────────────────────────────────────────────
# Push telemetry to Master PC running the Go backend on LAN
MASTER_IP=
MASTER_PORT=8080
ROOM_ID=
